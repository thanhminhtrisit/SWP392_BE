# SQL Server
SQLSERVER_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=lms_ai;encrypt=true;trustServerCertificate=true
SQLSERVER_DATASOURCE_USERNAME=sa
SQLSERVER_DATASOURCE_PASSWORD=your_sql_server_password

# JWT
APP_FRONTEND_BASE_URL=http://localhost:5173
APP_JWT_SECRET=replace_with_at_least_32_characters_secret
APP_JWT_EXPIRATION_MS=300000

# Mail / OTP
MAIL_USERNAME=your_gmail_address
MAIL_PASSWORD=your_gmail_app_password

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Azure Blob Storage (thay AWS S3 tu 2026-08-11)
# Lay connection string: Azure Portal -> Storage account -> Access keys.
# Bo trong ca hai dong dau thi bean storage khong duoc tao, app van khoi dong,
# chi rieng cac API upload/tai file la bao loi khi goi.
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string
AZURE_STORAGE_CONTAINER=your_container_name
AZURE_STORAGE_KEY_PREFIX=
AZURE_STORAGE_SAS_EXPIRATION_MINUTES=10

# Upload limits
APP_MAX_VIDEO_FILE_SIZE=52428800
APP_MAX_MULTIPART_FILE_SIZE=50MB
APP_MAX_MULTIPART_REQUEST_SIZE=50MB

# Gemini Embedding
SPRING_AI_MODEL_EMBEDDING_TEXT=google-genai
SPRING_AI_MODEL_CHAT=google-genai
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_CHAT_TEMPERATURE=0.2
GEMINI_API_KEY=your_fallback_gemini_api_key
GEMINI_CHAT_API_KEY=your_chat_gemini_api_key
GEMINI_EMBEDDING_API_KEY=your_embedding_gemini_api_key

# Google Speech-to-Text / video transcription
GOOGLE_CLOUD_PROJECT_ID=your_google_cloud_project_id
GOOGLE_SPEECH_GCS_BUCKET=your_google_speech_gcs_bucket
GOOGLE_SPEECH_GCS_KEY_PREFIX=transcribe-temp/
GOOGLE_SPEECH_TIMEOUT_SECONDS=600

# Tesseract OCR
TESSERACT_ENABLED=false
TESSERACT_EXECUTABLE_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_TESSDATA_PATH=C:\Program Files\Tesseract-OCR\tessdata
TESSERACT_LANGUAGE=eng
TESSERACT_TIMEOUT_SECONDS=60
TESSERACT_PDF_DPI=200
TESSERACT_PDF_TEXT_MIN_CHARACTERS=20

# Docling document parsing and hybrid chunking
DOCLING_ENABLED=false
DOCLING_BASE_URL=http://localhost:5001
DOCLING_API_KEY=
DOCLING_TIMEOUT_SECONDS=300
DOCLING_MAX_TOKENS=300
DOCLING_USE_MARKDOWN_TABLES=true
DOCLING_MERGE_PEERS=true
DOCLING_FALLBACK_ENABLED=true

# VNPay
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=
